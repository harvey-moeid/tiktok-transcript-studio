{
  "name": "@iankiku/anytranscript",
  "version": "1.2.0",
  "description": "TikTok Transcript Studio runner based on anytranscript",
  "type": "module",
  "license": "MIT",
  "author": "Ian Kiku <iankiku@gmail.com>",
  "bin": { "anytranscript": "dist/cli.js", "ant": "dist/cli.js" },
